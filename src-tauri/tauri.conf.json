{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "王源专属记账工作台",
  "version": "0.1.6",
  "identifier": "com.administrator.wangyuan-accounting",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "王源专属记账工作台",
        "width": 800,
        "height": 600,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://ghfast.top/https://github.com/SVEN-chr/wangyuan-accounting/releases/latest/download/latest.json",
        "https://gh-proxy.com/https://github.com/SVEN-chr/wangyuan-accounting/releases/latest/download/latest.json",
        "https://gh.llkk.cc/https://github.com/SVEN-chr/wangyuan-accounting/releases/latest/download/latest.json",
        "https://github.com/SVEN-chr/wangyuan-accounting/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDMUYzNTEzQzA4MUNGQzcKUldUSHo0SEFFelVmZkE2SnkxQXkvUk45V2NCYVdkZ29nTkUzOENpUjdBdm9yYTJSUVhsSlRJb3MK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "deb", "rpm", "appimage", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
